# Crumbs — server environment
# Square API key
SQUARE_API_KEY=YOUR_SQUARE_API_KEY_HERE

# Anthropic API key — invoice extraction + Upcoming Events feature
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Google OAuth (Gmail invoice ingestion) — Internal consent screen on the
# boxxcoffee Workspace domain; scope gmail.readonly only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nocrumbsleft.up.railway.app/api/gmail/callback

# Persistence — Railway volume mounted at /data (falls back to ./data locally)
DB_PATH=/data/crumbs.db
INVOICE_DIR=/data/invoices

# Cron + date bucketing depend on this
TZ=America/Los_Angeles
